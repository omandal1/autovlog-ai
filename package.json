{
  "name": "autovlog-ai",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "dev:frontend": "next dev",
    "dev:backend": "npm run backend",
    "backend": "ts-node -r tsconfig-paths/register --project tsconfig.scripts.json server/start.ts",
    "build": "next build",
    "start": "next start",
    "check": "tsc --noEmit",
    "test": "npm run test:api && npm run validate:diary && npm run validate:wall-frame",
    "test:api": "ts-node -r tsconfig-paths/register --project tsconfig.scripts.json server/__tests__/app.test.ts",
    "validate:diary": "ts-node -r tsconfig-paths/register --project tsconfig.scripts.json scripts/validate-diary-text.ts",
    "validate:wall-frame": "ts-node -r tsconfig-paths/register --project tsconfig.scripts.json scripts/validate-wall-frame.ts",
    "audit:legacy": "ts-node -r tsconfig-paths/register --project tsconfig.scripts.json scripts/audit-legacy-projects.ts",
    "python": "python -m uvicorn main:app --app-dir backend-python --host 127.0.0.1 --port 8001",
    "demo": "ts-node -r tsconfig-paths/register --project tsconfig.scripts.json scripts/run-demo.ts"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "exifr": "^7.1.3",
    "express": "^5.2.1",
    "ffmpeg-static": "^5.2.0",
    "ffprobe-static": "^3.1.0",
    "firebase": "^12.17.1",
    "firebase-admin": "^14.2.0",
    "heic-convert": "^2.1.0",
    "mongodb": "^7.5.0",
    "multer": "^2.2.0",
    "next": "16.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sharp": "0.35.3",
    "tailwind-merge": "^2.5.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.10.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/supertest": "^7.2.1",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "supertest": "^7.2.2",
    "tailwindcss": "^3.4.16",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.23.8",
    "typescript": "^5.7.2"
  }
}
