# Hosted Next.js frontend (also configure these in Vercel)
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8787
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Local/self-hosted API
HOST=127.0.0.1
PORT=8787
FRONTEND_ORIGIN=http://127.0.0.1:3000,http://localhost:3000
DATABASE_URL=mongodb://127.0.0.1:27017
MONGODB_DB_NAME=autovlog
STORAGE_ROOT=./storage

# Firebase Admin service account. Keep these backend-only.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Preserve the surrounding quotes and escaped newlines when using an env file.
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nREPLACE_ME\n-----END PRIVATE KEY-----\n"
# Alternative: point this at a local service-account JSON file.
GOOGLE_APPLICATION_CREDENTIALS=

# Upload and signed-file-delivery controls
MAX_MEDIA_FILE_BYTES=10737418240
MAX_SOUNDTRACK_FILE_BYTES=1073741824
MAX_FILES_PER_REQUEST=500
FILE_TICKET_SECRET=
FILE_TICKET_TTL_SECONDS=900

# Optional local analysis and FFmpeg overrides
PYTHON_SERVICE_URL=http://127.0.0.1:8001
FFMPEG_PATH=
FFPROBE_PATH=

# Read-only legacy audit source; legacy projects are not auto-claimed.
LEGACY_STORAGE_ROOT=./storage/projects
